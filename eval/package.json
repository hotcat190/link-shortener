{
  "name": "eval",
  "version": "1.0.0",
  "scripts": {
    "be": "node src/be_eval.js",
    "fe_get": "k6 run src/fe_get_eval.js > results/logs/fe_get.log",
    "fe_create": "k6 run src/fe_create_eval.js > results/logs/fe_create.log",
    "fe_both": "k6 run src/fe_both_eval.js > results/logs/fe_both.log",
    "fe_get_500": "k6 run src/fe_get_eval.js -e VUS=500 > results/logs/fe_get_500.log",
    "fe_create_500": "k6 run src/fe_create_eval.js -e VUS=500 > results/logs/fe_create_500.log",
    "fe_both_500": "k6 run src/fe_both_eval.js -e VUS=500 > results/logs/fe_both_500.log",
    "fe_both_100": "k6 run src/fe_both_eval.js -e VUS=100 > results/logs/fe_both_100.log",
    "fe_both_1000": "k6 run src/fe_both_eval.js -e VUS=1000 > results/logs/fe_both_1000.log",
    "eval_get": "run-p be fe_get",
    "eval_create": "run-p be fe_create",
    "eval_both": "run-p be fe_both",
    "eval_get_500": "run-p be fe_get_500",
    "eval_create_500": "run-p be fe_create_500",
    "eval_both_500": "run-p be fe_both_500",
    "eval_both_100": "run-p be fe_both_100",
    "eval_both_1000": "run-p be fe_both_1000",
    "eval_n": "sh -c 'k6 run src/fe_both_eval.js -e VUS=$1 > results/logs/ver3/fe_both_$1_$2_$3.log 2>/dev/null ; ' sh",
    "eval_create_n": "sh -c 'k6 run src/fe_create_eval.js -e VUS=$1 > results/logs/ver3/fe_create_$1_$2_$3.log 2>/dev/null ; ' sh",
    "eval_realistic_n": "sh -c 'k6 run src/fe_realistic_eval.js -e VUS=$1 > results/logs/ver3/fe_realistic_$1_$2_$3.log 2>/dev/null; ' sh",
    "eval_predictable_n": "sh -c 'k6 run src/fe_predictable_eval.js -e VUS=$1 > results/logs/ver3/fe_predictable_$1_$2_$3.log 2>/dev/null ; ' sh"
  },
  "dependencies": {
    "dockerode": "^4.0.5",
    "npm-run-all": "4.1.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Updated evaluation scripts for logging."
}
